---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import FullImage from '../components/FullImage.astro';
import SectionDivider from '../components/SectionDivider.astro';

const diarioHref = 'https://www.instagram.com/monfarmexperience?stkn=d2owbnBsMTdsOXY1';

const whatsappHref = `https://wa.me/393209318074?text=${encodeURIComponent(
  'Ciao Beatrice, vorrei maggiori informazioni sull’esperienza “RACCOLTO”.',
)}`;

const mapsHref = (place: string, city: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${place} ${city}`)}`;

const esperienze = [
  {
    date: 'Ottobre 2025',
    title: '“Evento Pilota: Le Radici”',
    location: 'Tenuta San Rocco',
    city: 'Conzano Monferrato (AL)',
    description:
      'Il nostro primo incontro, dove la visione ha preso forma. Due giorni immersi nei caldi colori autunnali per gettare i semi della community MonFarm, tra lentezza e prime pratiche condivise.',
    image: '/images/esperienze/esperienze-1.webp',
    imageAlt: "Gruppo di persone in cerchio al tramonto durante l'Evento Pilota Le Radici",
    cta: "Scopri com'è andata",
    href: 'https://www.instagram.com/stories/highlights/18080965583315408/',
  },
  {
    date: 'Dicembre 2025',
    title: '“Rituale d\'Inverno: la Luce che rinasce.”',
    location: 'Belvedere Monferrato',
    city: 'Vignale Monferrato (AL)',
    description:
      'Un tempo per fermarsi e accogliere il silenzio della stagione fredda. Abbiamo condiviso pratiche introspettive e calore attorno al fuoco, per ritrovare la centratura prima del nuovo anno.',
    image: '/images/esperienze/esperienze-2.webp',
    imageAlt: "Candela e oggetti sul pavimento durante il Rituale d'Inverno a Belvedere Monferrato",
    cta: "Scopri com'è andata",
    href: 'https://www.instagram.com/stories/highlights/18122420104541354/',
  },
  {
    date: 'Aprile 2026',
    title: '“Risveglio e Fioritura”',
    location: 'La Corte Delle 4 Stagioni',
    city: 'Ozzano Monferrato (AL)',
    description:
      'Un\'esperienza immersiva nella natura pensata per rallentare, ascoltarsi e lasciare emergere nuove energie. Tra pratiche dolci, condivisione e presenza, “Risveglio e Fioritura” è uno spazio protetto in cui concedersi tempo e trasformazione.',
    image: '/images/esperienze/esperienze-3.webp',
    imageAlt: "La Corte Delle 4 Stagioni — Ozzano Monferrato, sede dell'esperienza Risveglio e Fioritura",
    cta: "Scopri com'è andata",
    href: 'https://www.instagram.com/stories/highlights/18113576392660328/',
  },
  {
    date: 'Giugno 2026',
    title: '“Splendore – Nel cuore dell\'estate”',
    location: 'Cascina Baronina',
    city: 'Roncaglia, Casale Monferrato (AL)',
    description:
      'Un\'esperienza immersiva nel cuore dell\'estate, tra natura, movimento e pratiche dedicate alla presenza. Due giorni per rallentare, riconnettersi al corpo e lasciarsi attraversare dalla luce e dall\'energia della stagione, immersi nella quiete del Monferrato.',
    image: '/images/esperienze/esperienze-4.jpeg',
    imageAlt: "Cascina Baronina a Roncaglia, sede dell'esperienza Splendore – Nel cuore dell'estate",
    cta: "Scopri com'è andata",
    href: 'https://www.instagram.com/stories/highlights/18161383123393750/',
  },
  {
    date: 'Ottobre 2026',
    title: '“RACCOLTO — Corpo, creatività e convivialità nel tempo d’autunno”',
    location: 'Borgo Ramezzana Country House',
    city: 'Trino (VC)',
    description:
      'Una mattina per rallentare, tornare al corpo e fare spazio all’essenziale. Tra movimento, creatività e convivialità, abbiamo raccolto ciò che ci nutre, ciò che resta e ciò che possiamo lasciare andare, accompagnati dai colori e dai ritmi dell’autunno.',
    cta: 'Contattami su WhatsApp',
    href: whatsappHref,
  },
];
---

<Layout
  title="Esperienze"
  description="Le esperienze MonFarm: ritiri immersi nella natura del Monferrato. Le Radici, Rituale d'Inverno, Risveglio e Fioritura, Splendore, Raccolto."
>
  <PageHeader title="Esperienze" />

  {esperienze.map((exp, i) => (
    <>
      {exp.image && <FullImage src={exp.image} alt={exp.imageAlt} height="var(--image-mid-height)" />}
      <Section>
        <p class="text-date">{exp.date}</p>
        <p class="text-event-title">{exp.title}</p>
        <p class="text-place">
          <a
            href={mapsHref(exp.location, exp.city)}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Apri ${exp.location} su Google Maps`}
          >
            {exp.location}<br />
            {exp.city}
          </a>
        </p>
        <p class="text-body--thin">{exp.description}</p>
        <Button href={exp.href} text={exp.cta} />
      </Section>
      {i < esperienze.length - 1 && <SectionDivider bar={false} />}
    </>
  ))}

  <Section>
    <a class="note-box" href={diarioHref} target="_blank" rel="noopener noreferrer">
      <img class="note-box__deco" src="/images/diario.svg" alt="" width="302" height="302" loading="lazy" aria-hidden="true" />
      <em class="note-box__text">Sfoglia il nostro diario visivo in attesa di incontrarci dal vivo.</em>
    </a>
  </Section>
</Layout>
