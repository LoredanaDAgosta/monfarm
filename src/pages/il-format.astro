---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionDivider from '../components/SectionDivider.astro';
import SectionCenter from '../components/SectionCenter.astro';
import Section from '../components/Section.astro';
import FullImage from '../components/FullImage.astro';

const buildSteps = [
  {
    title: 'Il concept',
    text: "Ogni esperienza parte da un'intenzione chiara e da un tema guida.",
    icon: '/images/icons/concept.png',
  },
  {
    title: 'Il luogo',
    text: 'La scelta dello spazio non è casuale: deve essere coerente con la visione e favorire immersione e qualità relazionale.',
    icon: '/images/icons/luogo.png',
  },
  {
    title: 'Gli operatori',
    text: 'Professionisti selezionati per affinità valoriale e capacità di lavorare in piccoli gruppi.',
    icon: '/images/icons/operatori.png',
  },
  {
    title: 'Il gruppo',
    text: 'Attenzione alla composizione dei partecipanti, per garantire armonia e profondità.',
    icon: '/images/icons/gruppo.png',
  },
  {
    title: 'La cura',
    text: 'Ogni dettaglio viene accompagnato con attenzione: ritmo, spazi, tempi e comunicazione.',
    icon: '/images/icons/cura.png',
  },
];
---

<Layout
  title="Il Format"
  description="Il format MonFarm Experience: un approccio lento, umano e curato. Come si costruisce un'esperienza."
>
  <PageHeader title="Il format" />

  <FullImage
    src="/images/il-format/format-1.webp"
    alt="Persone che si allungano all'aperto durante un'esperienza MonFarm"
    height="var(--image-tall-height)"
  />

  <SectionCenter>
    <p class="text-intro">
      Un modo di progettare <em>esperienze</em> che mette al centro la
      relazione tra luogo, persone e pratiche.
    </p>
  </SectionCenter>

  <SectionDivider />

  <Section>
    <h4 class="text-subsection">Rallentare per tornare all'essenziale.</h4>
    <p class="text-body--thin">
      MonFarm Experience nasce dal desiderio di creare spazi in cui il tempo
      possa dilatarsi e la presenza tornare al centro.
    </p>
    <p class="text-body--thin">
      Crediamo nella natura come contesto generativo, nella lentezza come valore e nell'incontro come
      esperienza trasformativa.
    </p>
    <p class="text-body--thin">
      Ogni proposta nasce da una visione chiara: favorire connessioni autentiche,
      lontane dalla logica della performance o del consumo.
    </p>
    <p class="text-body--thin">
      Non si tratta di organizzare eventi, ma di <strong>curare processi</strong>.
    </p>
  </Section>

  <FullImage
    src="/images/il-format/format-2.webp"
    alt="Abbraccio tra persone in un contesto naturale"
    height="var(--image-mid-height)"
  />

  <SectionDivider />

  <Section>
    <p class="text-display">Come si costruisce un'<em>esperienza</em></p>

    <ul class="build-list" role="list">
      {buildSteps.map((step) => (
        <li class="build-item">
          <div class="build-item__icon" aria-hidden="true">
            <img src={step.icon} alt="" width="48" height="48" loading="lazy" />
          </div>
          <div class="build-item__body">
            <h4 class="text-subsection">{step.title}</h4>
            <p class="text-body--thin text-small">{step.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <SectionDivider />

  <Section>
    <div class="mi-presento">
      <h2 class="text-display text-display--italic mi-presento__title">Mi presento</h2>
      <img
        class="mi-presento__photo"
        src="/images/il-format/format-3.webp"
        alt="Beatrice Furia, fondatrice e curatrice di MonFarm Experience"
        width="960"
        height="1440"
        loading="lazy"
        decoding="async"
      />
      <div class="mi-presento__info">
        <p class="text-display text-display--md">Beatrice Furia</p>
        <p class="text-body--thin mi-presento__role">Fondatrice e curatrice di MonFarm Experience.</p>
      </div>
      <img
        class="mi-presento__deco"
        src="/images/unapprocciolento.svg"
        alt=""
        width="549"
        height="131"
        loading="lazy"
        aria-hidden="true"
      />
    </div>
  </Section>

  <SectionDivider />

  <Section>
    <h4 class="text-subsection text-subsection--serif">Il mio <em>ruolo</em></h4>
    <p class="text-body--thin">
      Il mio compito è tenere insieme tutti gli elementi dell'esperienza.
      Curo il concept, accompagno la progettazione con le strutture,
      seleziono gli operatori e custodisco la coerenza dell'intero percorso.
    </p>
    <p class="text-body--thin">
      Mi occupo della visione complessiva, affinché ogni esperienza sia
      armonica, autentica e rispettosa dei ritmi naturali.
    </p>
  </Section>

  <SectionDivider />

  <SectionCenter>
    <div class="invito__deco" aria-hidden="true">
      <img src="/images/relazione.svg" alt="" width="323" height="362" loading="lazy" />
    </div>
    <p class="text-intro invito__text">
      <em>MonFarm Experience è un invito a progettare insieme spazi di qualità,
      in cui la relazione diventa il cuore dell'esperienza.</em>
    </p>
  </SectionCenter>
</Layout>

<style>
.invito__deco {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.invito__deco img {
  position: absolute;
  right: -12%;
  bottom: -22%;
  width: min(62%, 22rem);
  height: auto;
}

.invito__text {
  position: relative;
  z-index: 1;
  padding-bottom: 7rem;
}
</style>
