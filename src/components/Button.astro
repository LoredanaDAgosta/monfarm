---
interface Props {
  href?: string;
  text: string;
  type?: 'submit' | 'button';
  disabled?: boolean;
}

const { href, text, type = 'submit', disabled = false } = Astro.props;
const isExternal = href?.startsWith('http');
---

{href ? (
  <a
    href={href}
    class="btn btn--primary text-cta"
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
  >{text}</a>
) : (
  <button type={type} class="btn btn--primary text-cta" disabled={disabled}>{text}</button>
)}
