<button type="button" class="scroll-top" aria-label="Torna in cima alla pagina" data-scroll-top>
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
    <path
      d="M3 11.5L9 5.5L15 11.5"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</button>

<style>
.scroll-top {
  position: fixed;
  right: 1rem;
  bottom: 1rem;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3rem;
  height: 3rem;
  padding: 0;
  border: 2px solid var(--color-cream-bg);
  border-radius: 50%;
  background-color: var(--color-olive);
  color: var(--color-cream-bg);
  box-shadow: 0 4px 14px rgba(113, 91, 67, 0.25);
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transform: translateY(0.5rem);
  transition:
    opacity var(--transition),
    transform var(--transition),
    visibility var(--transition),
    filter var(--transition);
}

.scroll-top.is-visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.scroll-top:hover {
  filter: brightness(1.1);
}

.scroll-top:focus-visible {
  outline: 2px solid var(--color-brown);
  outline-offset: 3px;
}

@media (prefers-reduced-motion: reduce) {
  .scroll-top {
    transition: none;
  }
}
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-scroll-top]');

  if (button) {
    const threshold = 300;

    const update = () => {
      button.classList.toggle('is-visible', window.scrollY > threshold);
    };

    window.addEventListener('scroll', update, { passive: true });
    update();

    button.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    });
  }
</script>
