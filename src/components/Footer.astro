---
import SectionDivider from "./SectionDivider.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">

  <div class="footer-body">
    <div class="container footer-body__inner stack stack--lg stack--center">

      <a href="/" class="footer-logo">
        <img src="/images/logo.svg" alt="MonFarm Experience" width="160" height="70" loading="lazy" />
      </a>

      <div class="footer-mid">
        <p class="text-lead">
          Un format di esperienze immersive nella natura, nato per creare
          <strong>connessioni autentiche</strong>.
        </p>

        <nav class="footer-nav" aria-label="Navigazione footer">
          <ul class="stack stack--flush" role="list">
            <li><a href="/" class="text-label">Home</a></li>
            <li><a href="/il-format" class="text-label">Il Format</a></li>
            <li><a href="/a-chi-e-rivolto" class="text-label">A Chi E' Rivolto</a></li>
            <li><a href="/esperienze" class="text-label">Esperienze</a></li>
            <li><a href="/collabora" class="text-label">Collabora</a></li>
          </ul>
        </nav>
      </div>

      <ul class="footer-contacts stack stack--sm stack--left" role="list">
        <li class="footer-contacts__item text-label">
          <img class="footer-contacts__icon" src="/images/icons/web.png" alt="" width="30" height="30" loading="lazy" />
          <a href="https://www.monfarmexperience.it">www.monfarmexperience.it</a>
        </li>
        <li class="footer-contacts__item text-label">
          <img class="footer-contacts__icon" src="/images/icons/phone.png" alt="" width="30" height="30" loading="lazy" />
          <a href="tel:+393209318074">+39 3209318074</a>
        </li>
        <li class="footer-contacts__item text-label">
          <img class="footer-contacts__icon" src="/images/icons/location.png" alt="" width="30" height="30" loading="lazy" />
          <span>Casale Monferrato<br />15033 (AL)</span>
        </li>
      </ul>

    </div>
  </div>

  <SectionDivider />

  <div class="footer-community">
    <div class="container footer-community__inner stack stack--lg stack--center">
      <h2 class="text-display text-display--lg">Entra nella community<br />MonFarm Experience!</h2>
      <div class="footer-social">
        <a
          href="https://www.instagram.com/monfarmexperience"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-social__icon"
          aria-label="MonFarm Experience su Instagram"
        >
          <img src="/images/icons/instagram.png" alt="" width="52" height="52" loading="lazy" />
        </a>
        <a
          href="https://www.facebook.com/monfarmexperience"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-social__icon"
          aria-label="MonFarm Experience su Facebook"
        >
          <img src="/images/icons/facebook.png" alt="" width="52" height="52" loading="lazy" />
        </a>
        <a
          href="https://www.tiktok.com/@monfarmexperience"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-social__icon"
          aria-label="MonFarm Experience su TikTok"
        >
          <img src="/images/icons/tiktok.png" alt="" width="52" height="52" loading="lazy" />
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom__inner stack stack--center">
      <p>&copy; {year} MonFarm Experience</p>
      <p>
        <a href="/privacy-policy">Privacy Policy</a>
      </p>
    </div>
  </div>

</footer>

<style>
.footer-body {
  background-color: var(--color-cream-bg);
  padding-block: var(--space-xl);
}

.footer-body__inner {
  width: 100%;
}

.footer-logo img {
  height: 56px;
  width: auto;
}

.footer-mid {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: var(--space-lg);
  width: 100%;
}

.footer-mid > .text-lead {
  flex: 1;
  max-width: 58%;
  text-align: left;
  margin: 0;
}

.footer-mid .text-lead strong {
  font-weight: 500;
}

.footer-nav {
  flex: 1;
  max-width: 42%;
  display: flex;
  flex-direction: column;
}

.footer-nav .stack {
  list-style: none;
  align-items: flex-end;
  flex: 1;
  justify-content: space-between;
  height: 100%;
}

.footer-nav a {
  font-weight: 400;
  text-decoration: none;
  line-height: 1.35;
  transition: color var(--transition);
}

.footer-nav a:hover {
  color: var(--color-brown);
}

.footer-contacts {
  list-style: none;
  width: 100%;
}

.footer-contacts a {
  color: inherit;
  text-decoration: none;
}

.footer-contacts a:hover {
  color: var(--color-brown);
  opacity: 1;
}

.footer-contacts .text-label {
  font-size: clamp(0.8rem, 2.4vw, 0.95rem);
  font-weight: 400;
}

.footer-contacts__item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.footer-contacts__item > :not(img) {
  min-width: 0;
  overflow-wrap: anywhere;
}

.footer-contacts__icon {
  width: 30px;
  height: 30px;
  flex-shrink: 0;
  object-fit: contain;
  display: block;
}

.footer-community {
  padding-block: var(--space-xl);
}

.footer-social {
  display: flex;
  gap: var(--space-md);
  align-items: center;
}

.footer-social__icon {
  display: block;
  width: 52px;
  height: 52px;
  text-decoration: none;
  transition: opacity var(--transition), transform var(--transition);
}

.footer-social__icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.footer-social__icon:hover {
  opacity: 0.8;
  transform: translateY(-2px);
}

.footer-bottom {
  background-color: var(--color-olive);
  padding-block: var(--space-md);
}

.footer-bottom p {
  font-size: 0.8rem;
  color: var(--color-cream-bg);
  opacity: 0.9;
}

.footer-bottom a {
  color: var(--color-cream-bg);
  text-decoration: underline;
  opacity: 0.8;
  transition: opacity var(--transition);
}

.footer-bottom a:hover {
  opacity: 1;
}
</style>
